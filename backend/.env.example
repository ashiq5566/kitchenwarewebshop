# ─────────────────────────────────────────────
# SteelNest Backend — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Django
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend.vercel.app,localhost

# Neon PostgreSQL  (get from neon.tech dashboard)
DB_NAME=steelkitchen
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech
DB_PORT=5432

# Cloudinary  (get from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
